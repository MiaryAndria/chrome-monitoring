[Unit]
Description=Chrome Monitoring - Synchronisation Google automatique
Documentation=file://__APP_DIR__/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__/code
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP_DIR__/code/venv/bin/python -m backend.worker
Restart=always
RestartSec=10
TimeoutStopSec=360

[Install]
WantedBy=multi-user.target
