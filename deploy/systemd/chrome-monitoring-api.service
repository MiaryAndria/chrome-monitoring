[Unit]
Description=Chrome Monitoring - API FastAPI (routes)
Documentation=file://__APP_DIR__/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__/code
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP_DIR__/code/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
